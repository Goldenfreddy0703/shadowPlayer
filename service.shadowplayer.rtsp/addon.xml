<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.shadowplayer.rtsp" name="Shadow Player RTSP Service" provider-name="Goldenfreddy0703" version="1.0.0">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">RTSP to HLS transcoding service for Shadow Player</summary>
        <description lang="en">Converts RTSP streams to HLS for browser playback. Use with Screen Stream app to mirror your Kodi screen to any browser.</description>
        <license>GPL-3.0</license>
    </extension>
</addon>
